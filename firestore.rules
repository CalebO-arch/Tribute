rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Memorial information rules
    match /memorial_info/main {
      allow read: if true;
      allow write: if true;
    }

    // Tributes rules
    match /tributes/{tributeId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Candles rules
    match /candles/{candleId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Prayers rules
    match /prayers/{prayerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
